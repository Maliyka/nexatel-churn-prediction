# Copy to .env.local for local development (optional — Vite's dev proxy
# already forwards /api to localhost:8000 without this, see vite.config.js).
#
# REQUIRED in production: set this as a Vercel environment variable to your
# deployed Render backend URL, e.g. https://nexatel-churn-api.onrender.com
VITE_API_URL=https://your-backend.onrender.com
