# Copy this file to .env for local development. Never commit the real .env file.

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default covers Vite (5173) and CRA (3000).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Only needed if you re-run database/load_data.py against your own Supabase/
# Postgres instance -- the deployed API itself does NOT need a database
# connection, since it loads model.pkl directly from disk.
DATABASE_URL=postgresql://nexatel_user:nexatel_dev_pw@localhost:5432/nexatel_churn
